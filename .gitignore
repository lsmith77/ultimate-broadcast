# Operator state, written by the web server. Per installation, not code:
# what is on air, kit colours, shared line-selection rooms, and the commentary
# desk's prepared notes -- which are notes about named players and must not
# reach a repository under any circumstances.
/conf/

# Team logos are an installation's own data — the file being there IS the
# configuration (shared/logos.php), so a logo committed here would brand
# whichever team happens to hold that id on somebody else's tournament.
# The directory is tracked; its contents are not.
/logos/*
!/logos/README.md

# Events authored on this installation by install/make-event.php. Somebody's
# tournament — their teams and their squads — not this project's data.
/events/

# Where one person's installation lives — an SSH target, not a project setting.
# deploy.env.example is tracked and shows the shape.
/deploy.env

# Playwright
/node_modules/
/test-results/
/playwright-report/
/docs/images/.frames/

# Copy this file to deploy.env and fill it in. deploy.env is gitignored and
# never committed. See docs/DEPLOY.md.

# Where the installation lives, as rsync sees it: an SSH target and the
# directory the web server serves. The trailing slash is added by the script.
#
# On cyon each domain is a directory under public_html named after the domain
# itself, and that directory IS the document root — which is why the standalone
# rules assume `RewriteBase /`.
REMOTE="user@sNNN.cyon.net:/home/user/public_html/ultimate-broadcast.org"

# Optional. macOS ships rsync 2.6 as /usr/bin/rsync; a newer one from Homebrew
# is not required here, but set this if you want to pin which is used.
# RSYNC="/opt/homebrew/bin/rsync"
